//@version=5
strategy("Trend Short Continuation Strategy v3", overlay=true, pyramiding=0, initial_capital=10000, commission_type=strategy.commission.percent, commission_value=0.01, max_labels_count=500)

groupMode = "Testing Mode"
positionMode = input.string("Fixed qty", "Position Mode", options=["Fixed qty", "Risk-based"], group=groupMode)
fixedQty = input.float(10000, "Fixed Qty", minval=0.01, step=1000, group=groupMode)

groupTrend = "Trend Filter"
biasTf = input.timeframe("60", "Bias Timeframe", group=groupTrend)
emaFastLen = input.int(20, "Fast EMA", minval=1, group=groupTrend)
emaSlowLen = input.int(50, "Slow EMA", minval=1, group=groupTrend)
useSlopeFilter = input.bool(true, "Use EMA Slope Filter", group=groupTrend)
slopeLookback = input.int(5, "Slope Lookback", minval=1, group=groupTrend)
useSeparationFilter = input.bool(true, "Use EMA Separation Filter", group=groupTrend)
minSepAtr = input.float(0.15, "Min EMA Separation (ATR)", minval=0.0, step=0.05, group=groupTrend)

groupStructure = "Continuation Structure"
pullbackLookback = input.int(10, "Pullback Lookback Bars", minval=3, group=groupStructure)
confirmBars = input.int(2, "Confirmation Bars After Pullback", minval=1, maxval=5, group=groupStructure)
zoneAtrBuffer = input.float(0.25, "Pullback Zone Buffer (ATR)", minval=0.05, step=0.05, group=groupStructure)
requireLowerHigh = input.bool(true, "Require Lower High", group=groupStructure)
maxDistanceFromSlowEmaAtr = input.float(0.60, "Max Distance From Slow EMA (ATR)", minval=0.1, step=0.05, group=groupStructure)

groupRisk = "Risk"
atrLen = input.int(14, "ATR Length", minval=1, group=groupRisk)
slAtrBuffer = input.float(0.20, "SL ATR Buffer", minval=0.05, step=0.05, group=groupRisk)
rr = input.float(2.0, "Risk Reward", minval=0.5, step=0.1, group=groupRisk)
riskPct = input.float(1.0, "Risk % of Equity", minval=0.1, maxval=5.0, step=0.1, group=groupRisk)
enableBE = input.bool(false, "Move Stop to Breakeven at 1R", group=groupRisk)

groupCost = "Execution Costs"
pipMultiplier = input.int(10, "Pip Size Multiplier vs Mintick", minval=1, group=groupCost)
spreadPips = input.float(0.8, "Spread (pips)", minval=0.0, step=0.1, group=groupCost)
slippagePips = input.float(0.2, "Slippage (pips)", minval=0.0, step=0.1, group=groupCost)

groupSession = "Session"
sessionFilter = input.session("1300-2200", "Trading Session", group=groupSession)
useSessionFilter = input.bool(true, "Use Session Filter", group=groupSession)

groupVis = "Visuals"
showSignals = input.bool(true, "Show Signals", group=groupVis)
showTrendEma = input.bool(true, "Show Trend EMAs", group=groupVis)
showExecutionEma = input.bool(true, "Show Execution EMAs", group=groupVis)
showLevels = input.bool(true, "Show Active Levels", group=groupVis)
showBreakLine = input.bool(true, "Show Breakdown Line", group=groupVis)

pipSize = syminfo.mintick * pipMultiplier
costOffset = (spreadPips + slippagePips) * pipSize
inSession = not na(time(timeframe.period, sessionFilter))
atr = ta.atr(atrLen)

htfClose = request.security(syminfo.tickerid, biasTf, close, barmerge.gaps_off, barmerge.lookahead_off)
htfFast = request.security(syminfo.tickerid, biasTf, ta.ema(close, emaFastLen), barmerge.gaps_off, barmerge.lookahead_off)
htfSlow = request.security(syminfo.tickerid, biasTf, ta.ema(close, emaSlowLen), barmerge.gaps_off, barmerge.lookahead_off)

execFast = ta.ema(close, emaFastLen)
execSlow = ta.ema(close, emaSlowLen)

sepOk = not useSeparationFilter or math.abs(htfFast - htfSlow) >= atr * minSepAtr
slopeDown = not useSlopeFilter or htfSlow < htfSlow[slopeLookback]
downTrend = htfClose < htfSlow and htfFast < htfSlow and slopeDown and sepOk
sessionOk = not useSessionFilter or inSession

plot(showTrendEma ? htfFast : na, "HTF EMA 20 Proxy", color=color.new(color.green, 70))
plot(showTrendEma ? htfSlow : na, "HTF EMA 50 Proxy", color=color.new(color.red, 70))
plot(showExecutionEma ? execFast : na, "Exec EMA 20", color=color.new(color.green, 0))
plot(showExecutionEma ? execSlow : na, "Exec EMA 50", color=color.new(color.red, 0))

ph = ta.pivothigh(high, 3, 3)
pl = ta.pivotlow(low, 3, 3)

var float lastSwingHigh = na
var float prevSwingHigh = na
var float lastSwingLow = na

if not na(ph)
    prevSwingHigh := lastSwingHigh
    lastSwingHigh := ph

if not na(pl)
    lastSwingLow := pl

pullbackTouchedZone = high >= execFast - atr * zoneAtrBuffer and high <= execSlow + atr * zoneAtrBuffer
closeBelowFast = close < execFast
distanceOk = math.abs(close - execSlow) <= atr * maxDistanceFromSlowEmaAtr
lowerHighOk = not requireLowerHigh or (not na(lastSwingHigh) and not na(prevSwingHigh) and lastSwingHigh < prevSwingHigh)

pullbackRecent = ta.barssince(pullbackTouchedZone) <= pullbackLookback
confirmBearishBars = ta.highest(close >= open ? 1.0 : 0.0, confirmBars) == 0
breakRef = ta.lowest(low[1], confirmBars)
breakdown = close < breakRef and close < low[1]

shortSetup = sessionOk and downTrend and pullbackRecent and closeBelowFast and distanceOk and lowerHighOk and confirmBearishBars and breakdown

baseShortStop = na(lastSwingHigh) ? na : lastSwingHigh + atr * slAtrBuffer
shortEntryPrice = close - costOffset
shortRiskPerUnit = na(baseShortStop) ? na : baseShortStop - shortEntryPrice
riskCash = strategy.equity * (riskPct / 100.0)
shortQtyRisk = not na(shortRiskPerUnit) and shortRiskPerUnit > syminfo.mintick ? riskCash / shortRiskPerUnit : na
shortQty = positionMode == "Fixed qty" ? fixedQty : shortQtyRisk
validShort = shortSetup and not na(shortQty) and shortQty > 0 and not na(shortRiskPerUnit) and shortRiskPerUnit > syminfo.mintick

var float activeShortStop = na
var float activeShortTarget = na
var float activeShortRisk = na

if validShort and strategy.position_size >= 0
    activeShortStop := baseShortStop
    activeShortRisk := activeShortStop - shortEntryPrice
    activeShortTarget := shortEntryPrice - activeShortRisk * rr
    strategy.entry("Short", strategy.short, qty=shortQty)

if strategy.position_size < 0 and not na(activeShortStop) and not na(activeShortTarget)
    if enableBE and not na(activeShortRisk) and close <= strategy.position_avg_price - activeShortRisk
        activeShortStop := math.min(activeShortStop, strategy.position_avg_price)
    strategy.exit("Short Exit", "Short", stop=activeShortStop, limit=activeShortTarget)

plotshape(showSignals and validShort, title="SELL", text="SELL", style=shape.labeldown, location=location.abovebar, color=color.new(color.red, 0), textcolor=color.white, size=size.small)
plot(showLevels and strategy.position_size < 0 ? strategy.position_avg_price : na, "Short Entry", color=color.new(color.green, 20), style=plot.style_linebr)
plot(showLevels and strategy.position_size < 0 ? activeShortStop : na, "Short Stop", color=color.new(color.red, 0), style=plot.style_linebr)
plot(showLevels and strategy.position_size < 0 ? activeShortTarget : na, "Short Target", color=color.new(color.blue, 0), style=plot.style_linebr)
plot(showBreakLine ? breakRef : na, "Breakdown Reference", color=color.new(color.orange, 0), style=plot.style_linebr)

alertcondition(validShort, "Short Continuation v3 SELL", "Short continuation setup confirmed by lower high and breakdown")
