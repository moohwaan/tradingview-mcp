//@version=5
indicator("SMC Reversal BOS Fib Indicator v1.0", overlay=true, max_labels_count=500, max_lines_count=500)

groupStructure = "Structure"
pivotLeft = input.int(3, "Pivot Left", minval=1, group=groupStructure)
pivotRight = input.int(3, "Pivot Right", minval=1, group=groupStructure)
minSwingAtr = input.float(0.5, "Min Swing Size (ATR)", minval=0.0, step=0.1, group=groupStructure)
useCloseBreakOnly = input.bool(true, "Use Close Break Only", group=groupStructure)
setupExpiryBars = input.int(20, "Setup Expiry Bars", minval=1, group=groupStructure)
showChoChLabels = input.bool(true, "Show ChoCh Labels", group=groupStructure)

groupFib = "Fib Retest"
fibShallowLow = input.float(0.382, "Shallow Low", minval=0.1, maxval=0.9, step=0.001, group=groupFib)
fibShallowHigh = input.float(0.5, "Shallow High", minval=0.1, maxval=0.9, step=0.001, group=groupFib)
fibMid = input.float(0.618, "Mid Level", minval=0.1, maxval=0.95, step=0.001, group=groupFib)
fibDeep = input.float(0.786, "Deep Level", minval=0.1, maxval=0.99, step=0.001, group=groupFib)
zoneBufferAtr = input.float(0.15, "Zone Buffer (ATR)", minval=0.01, step=0.01, group=groupFib)
useTargetByRetestDepth = input.bool(false, "Use Target By Retest Depth", group=groupFib)

groupConfirm = "Confirmation"
confirmMode = input.string("Either", "Confirm Mode", options=["Engulfing", "Strong Engulfing", "Pin Bar", "Either"], group=groupConfirm)
minBodyAtr = input.float(0.15, "Min Body Size (ATR)", minval=0.01, step=0.01, group=groupConfirm)
requireDirectionalClose = input.bool(true, "Require Directional Close", group=groupConfirm)
pinBarWickRatio = input.float(2.0, "Pin Bar Wick Ratio", minval=1.0, step=0.1, group=groupConfirm)

groupRisk = "Targets / Stops"
atrLen = input.int(14, "ATR Length", minval=1, group=groupRisk)
slAtrBuffer = input.float(0.2, "SL ATR Buffer", minval=0.01, step=0.01, group=groupRisk)
riskRewardPrimary = input.float(2.0, "Fixed Risk Reward", minval=0.5, step=0.1, group=groupRisk)
tp1Mode = input.string("1R", "TP1 Mode", options=["1R", "1.2 Fib"], group=groupRisk)

groupFilters = "Filters"
tradeDirection = input.string("Both", "Trade Direction", options=["Both", "Long only", "Short only"], group=groupFilters)
useTrendFilter = input.bool(false, "Use HTF Trend Filter", group=groupFilters)
biasTf = input.timeframe("60", "Bias Timeframe", group=groupFilters)
emaFastLen = input.int(20, "HTF Fast EMA", minval=1, group=groupFilters)
emaSlowLen = input.int(50, "HTF Slow EMA", minval=1, group=groupFilters)
useSessionFilter = input.bool(false, "Use Session Filter", group=groupFilters)
sessionInput = input.session("1300-2200", "Trading Session", group=groupFilters)

groupVisuals = "Visuals"
showSignals = input.bool(true, "Show Setup + Entry Labels", group=groupVisuals)
showLevels = input.bool(true, "Show Fib and Trade Levels", group=groupVisuals)
showTrendEma = input.bool(false, "Show HTF EMAs", group=groupVisuals)
showDebugPlots = input.bool(false, "Show Debug Plots", group=groupVisuals)
showDashboard = input.bool(true, "Show Dashboard", group=groupVisuals)

atr = ta.atr(atrLen)
buffer = atr * zoneBufferAtr
inSession = not na(time(timeframe.period, sessionInput))
allowLong = tradeDirection == "Both" or tradeDirection == "Long only"
allowShort = tradeDirection == "Both" or tradeDirection == "Short only"
sessionOk = not useSessionFilter or inSession

htfClose = request.security(syminfo.tickerid, biasTf, close, barmerge.gaps_off, barmerge.lookahead_off)
htfFast = request.security(syminfo.tickerid, biasTf, ta.ema(close, emaFastLen), barmerge.gaps_off, barmerge.lookahead_off)
htfSlow = request.security(syminfo.tickerid, biasTf, ta.ema(close, emaSlowLen), barmerge.gaps_off, barmerge.lookahead_off)
trendLongOk = not useTrendFilter or (htfClose > htfSlow and htfFast > htfSlow)
trendShortOk = not useTrendFilter or (htfClose < htfSlow and htfFast < htfSlow)

plot(showTrendEma ? htfFast : na, "HTF EMA Fast", color=color.new(color.green, 65))
plot(showTrendEma ? htfSlow : na, "HTF EMA Slow", color=color.new(color.red, 65))

ph = ta.pivothigh(high, pivotLeft, pivotRight)
pl = ta.pivotlow(low, pivotLeft, pivotRight)

var float lastSwingHigh = na
var float lastSwingLow = na
var int lastSwingHighBar = na
var int lastSwingLowBar = na
var int structureBias = 0

if not na(ph)
    pivotBar = bar_index - pivotRight
    if na(lastSwingLow) or math.abs(ph - lastSwingLow) >= atr * minSwingAtr
        lastSwingHigh := ph
        lastSwingHighBar := pivotBar

if not na(pl)
    pivotBar = bar_index - pivotRight
    if na(lastSwingHigh) or math.abs(lastSwingHigh - pl) >= atr * minSwingAtr
        lastSwingLow := pl
        lastSwingLowBar := pivotBar

bullBreak = not na(lastSwingHigh) and (useCloseBreakOnly ? (close > lastSwingHigh and close[1] <= lastSwingHigh) : (high > lastSwingHigh and high[1] <= lastSwingHigh))
bearBreak = not na(lastSwingLow) and (useCloseBreakOnly ? (close < lastSwingLow and close[1] >= lastSwingLow) : (low < lastSwingLow and low[1] >= lastSwingLow))

bullChoCh = bullBreak and structureBias <= -1
bearChoCh = bearBreak and structureBias >= 1

if bullBreak
    structureBias := 1
if bearBreak
    structureBias := -1

bullSetupTrigger = bullBreak and not na(lastSwingLowBar) and not na(lastSwingHighBar) and lastSwingLowBar > lastSwingHighBar
bearSetupTrigger = bearBreak and not na(lastSwingLowBar) and not na(lastSwingHighBar) and lastSwingHighBar > lastSwingLowBar

var int activeSetupDir = 0
var float setupOrigin = na
var float setupBroken = na
var float setupRange = na
var float setupStop = na
var int setupStartBar = na
var string lastSetupReason = "None"

if bullSetupTrigger
    activeSetupDir := 1
    setupOrigin := lastSwingLow
    setupBroken := lastSwingHigh
    setupRange := setupBroken - setupOrigin
    setupStop := setupOrigin - atr * slAtrBuffer
    setupStartBar := bar_index
    lastSetupReason := bullChoCh ? "Bull ChoCh -> BOS" : "Bull BOS"

if bearSetupTrigger
    activeSetupDir := -1
    setupOrigin := lastSwingHigh
    setupBroken := lastSwingLow
    setupRange := setupOrigin - setupBroken
    setupStop := setupOrigin + atr * slAtrBuffer
    setupStartBar := bar_index
    lastSetupReason := bearChoCh ? "Bear ChoCh -> BOS" : "Bear BOS"

setupAge = activeSetupDir == 0 or na(setupStartBar) ? 0 : bar_index - setupStartBar
setupExpired = activeSetupDir != 0 and setupAge > setupExpiryBars
setupInvalid = activeSetupDir == 1 ? low <= nz(setupStop, low - 1) : activeSetupDir == -1 ? high >= nz(setupStop, high + 1) : false

if setupExpired or setupInvalid
    activeSetupDir := 0
    setupOrigin := na
    setupBroken := na
    setupRange := na
    setupStop := na
    setupStartBar := na

longFib382 = activeSetupDir == 1 and not na(setupRange) ? setupOrigin + setupRange * fibShallowLow : na
longFib50 = activeSetupDir == 1 and not na(setupRange) ? setupOrigin + setupRange * fibShallowHigh : na
longFib618 = activeSetupDir == 1 and not na(setupRange) ? setupOrigin + setupRange * fibMid : na
longFib786 = activeSetupDir == 1 and not na(setupRange) ? setupOrigin + setupRange * fibDeep : na
longFib12 = activeSetupDir == 1 and not na(setupRange) ? setupOrigin + setupRange * 1.2 : na

shortFib382 = activeSetupDir == -1 and not na(setupRange) ? setupOrigin - setupRange * fibShallowLow : na
shortFib50 = activeSetupDir == -1 and not na(setupRange) ? setupOrigin - setupRange * fibShallowHigh : na
shortFib618 = activeSetupDir == -1 and not na(setupRange) ? setupOrigin - setupRange * fibMid : na
shortFib786 = activeSetupDir == -1 and not na(setupRange) ? setupOrigin - setupRange * fibDeep : na
shortFib12 = activeSetupDir == -1 and not na(setupRange) ? setupOrigin - setupRange * 1.2 : na

longShallow = activeSetupDir == 1 and not na(longFib382) and low <= longFib50 + buffer and low >= longFib382 - buffer
longMid = activeSetupDir == 1 and not na(longFib618) and low <= longFib618 + buffer and low >= longFib618 - buffer
longDeep = activeSetupDir == 1 and not na(longFib786) and low <= longFib786 + buffer and low >= longFib786 - buffer
shortShallow = activeSetupDir == -1 and not na(shortFib382) and high >= shortFib50 - buffer and high <= shortFib382 + buffer
shortMid = activeSetupDir == -1 and not na(shortFib618) and high >= shortFib618 - buffer and high <= shortFib618 + buffer
shortDeep = activeSetupDir == -1 and not na(shortFib786) and high >= shortFib786 - buffer and high <= shortFib786 + buffer

longDepthClass = longDeep ? 3 : longMid ? 2 : longShallow ? 1 : 0
shortDepthClass = shortDeep ? 3 : shortMid ? 2 : shortShallow ? 1 : 0
depthClass = activeSetupDir == 1 ? longDepthClass : activeSetupDir == -1 ? shortDepthClass : 0
depthName = depthClass == 3 ? "Deep" : depthClass == 2 ? "Mid" : depthClass == 1 ? "Shallow" : "None"

bullishEngulfing = close > open and close[1] < open[1] and close >= open[1] and open <= close[1]
bearishEngulfing = close < open and close[1] > open[1] and close <= open[1] and open >= close[1]
strongBullishEngulfing = bullishEngulfing and close > high[1]
strongBearishEngulfing = bearishEngulfing and close < low[1]

bodySize = math.abs(close - open)
upperWick = high - math.max(open, close)
lowerWick = math.min(open, close) - low
bodyOk = bodySize >= atr * minBodyAtr
smallBodyOk = bodySize <= atr * minBodyAtr * 1.5

bullPinBar = lowerWick >= bodySize * pinBarWickRatio and upperWick <= lowerWick * 0.5 and close > open
bearPinBar = upperWick >= bodySize * pinBarWickRatio and lowerWick <= upperWick * 0.5 and close < open

confirmLongBase = confirmMode == "Strong Engulfing" ? strongBullishEngulfing : confirmMode == "Pin Bar" ? bullPinBar : confirmMode == "Either" ? (bullishEngulfing or bullPinBar) : bullishEngulfing
confirmShortBase = confirmMode == "Strong Engulfing" ? strongBearishEngulfing : confirmMode == "Pin Bar" ? bearPinBar : confirmMode == "Either" ? (bearishEngulfing or bearPinBar) : bearishEngulfing

longQualityOk = bullPinBar and not bullishEngulfing ? smallBodyOk : bodyOk
shortQualityOk = bearPinBar and not bearishEngulfing ? smallBodyOk : bodyOk

confirmLong = confirmLongBase and longQualityOk and (not requireDirectionalClose or close > open)
confirmShort = confirmShortBase and shortQualityOk and (not requireDirectionalClose or close < open)
confirmName = confirmLong ? (bullPinBar and not bullishEngulfing ? "Pin Bar" : strongBullishEngulfing ? "Strong Engulf" : bullishEngulfing ? "Engulf" : "None") : confirmShort ? (bearPinBar and not bearishEngulfing ? "Pin Bar" : strongBearishEngulfing ? "Strong Engulf" : bearishEngulfing ? "Engulf" : "None") : "None"

longReady = allowLong and sessionOk and trendLongOk and activeSetupDir == 1 and depthClass > 0 and confirmLong and setupAge > 0
shortReady = allowShort and sessionOk and trendShortOk and activeSetupDir == -1 and depthClass > 0 and confirmShort and setupAge > 0

targetMultiplier = depthClass == 3 ? 1.2 : depthClass == 2 ? 1.618 : depthClass == 1 ? 2.0 : na
longDepthTarget = activeSetupDir == 1 and not na(setupRange) and not na(targetMultiplier) ? setupOrigin + setupRange * targetMultiplier : na
shortDepthTarget = activeSetupDir == -1 and not na(setupRange) and not na(targetMultiplier) ? setupOrigin - setupRange * targetMultiplier : na

signalLong = longReady
signalShort = shortReady

var int activeTradeDir = 0
var float activeEntry = na
var float activeStop = na
var float activeTp1 = na
var float activeFinalTarget = na
var int activeTradeDepthClass = 0
var string activeTradeReason = "None"

activeTradeDepthName = activeTradeDepthClass == 3 ? "Deep" : activeTradeDepthClass == 2 ? "Mid" : activeTradeDepthClass == 1 ? "Shallow" : "None"

if signalLong
    riskDistance = close - setupStop
    if riskDistance > syminfo.mintick
        activeTradeDir := 1
        activeEntry := close
        activeStop := setupStop
        activeTp1 := tp1Mode == "1.2 Fib" and not na(longFib12) ? longFib12 : close + riskDistance
        activeFinalTarget := useTargetByRetestDepth and not na(longDepthTarget) ? longDepthTarget : close + riskDistance * riskRewardPrimary
        activeTradeDepthClass := depthClass
        activeTradeReason := lastSetupReason + " / " + depthName + " / " + confirmName
        activeSetupDir := 0
        setupOrigin := na
        setupBroken := na
        setupRange := na
        setupStop := na
        setupStartBar := na

if signalShort
    riskDistance = setupStop - close
    if riskDistance > syminfo.mintick
        activeTradeDir := -1
        activeEntry := close
        activeStop := setupStop
        activeTp1 := tp1Mode == "1.2 Fib" and not na(shortFib12) ? shortFib12 : close - riskDistance
        activeFinalTarget := useTargetByRetestDepth and not na(shortDepthTarget) ? shortDepthTarget : close - riskDistance * riskRewardPrimary
        activeTradeDepthClass := depthClass
        activeTradeReason := lastSetupReason + " / " + depthName + " / " + confirmName
        activeSetupDir := 0
        setupOrigin := na
        setupBroken := na
        setupRange := na
        setupStop := na
        setupStartBar := na

longStopHit = activeTradeDir == 1 and not na(activeStop) and low <= activeStop
longTargetHit = activeTradeDir == 1 and not na(activeFinalTarget) and high >= activeFinalTarget
shortStopHit = activeTradeDir == -1 and not na(activeStop) and high >= activeStop
shortTargetHit = activeTradeDir == -1 and not na(activeFinalTarget) and low <= activeFinalTarget

if longStopHit or longTargetHit or shortStopHit or shortTargetHit
    activeTradeDir := 0
    activeEntry := na
    activeStop := na
    activeTp1 := na
    activeFinalTarget := na
    activeTradeDepthClass := 0
    activeTradeReason := "None"

plotshape(showSignals and bullChoCh and showChoChLabels, title="Bull ChoCh", text="ChoCh Up", style=shape.labelup, location=location.belowbar, color=color.new(color.blue, 0), textcolor=color.white, size=size.tiny)
plotshape(showSignals and bearChoCh and showChoChLabels, title="Bear ChoCh", text="ChoCh Dn", style=shape.labeldown, location=location.abovebar, color=color.new(color.purple, 0), textcolor=color.white, size=size.tiny)
plotshape(showSignals and bullSetupTrigger, title="Bull BOS", text="BOS Up", style=shape.labelup, location=location.belowbar, color=color.new(color.teal, 0), textcolor=color.white, size=size.tiny)
plotshape(showSignals and bearSetupTrigger, title="Bear BOS", text="BOS Dn", style=shape.labeldown, location=location.abovebar, color=color.new(color.orange, 0), textcolor=color.white, size=size.tiny)
plotshape(showSignals and signalLong, title="Long Signal", text="BUY", style=shape.labelup, location=location.belowbar, color=color.new(color.green, 0), textcolor=color.white, size=size.small)
plotshape(showSignals and signalShort, title="Short Signal", text="SELL", style=shape.labeldown, location=location.abovebar, color=color.new(color.red, 0), textcolor=color.white, size=size.small)

plot(showLevels and activeSetupDir == 1 ? longFib382 : na, "Long Fib 0.382", color=color.new(color.green, 65), style=plot.style_linebr)
plot(showLevels and activeSetupDir == 1 ? longFib50 : na, "Long Fib 0.5", color=color.new(color.green, 45), style=plot.style_linebr)
plot(showLevels and activeSetupDir == 1 ? longFib618 : na, "Long Fib 0.618", color=color.new(color.green, 25), style=plot.style_linebr)
plot(showLevels and activeSetupDir == 1 ? longFib786 : na, "Long Fib 0.786", color=color.new(color.green, 5), style=plot.style_linebr)
plot(showLevels and activeSetupDir == -1 ? shortFib382 : na, "Short Fib 0.382", color=color.new(color.red, 65), style=plot.style_linebr)
plot(showLevels and activeSetupDir == -1 ? shortFib50 : na, "Short Fib 0.5", color=color.new(color.red, 45), style=plot.style_linebr)
plot(showLevels and activeSetupDir == -1 ? shortFib618 : na, "Short Fib 0.618", color=color.new(color.red, 25), style=plot.style_linebr)
plot(showLevels and activeSetupDir == -1 ? shortFib786 : na, "Short Fib 0.786", color=color.new(color.red, 5), style=plot.style_linebr)

plot(showLevels and activeTradeDir != 0 ? activeEntry : na, "Entry", color=color.new(color.green, 20), style=plot.style_linebr)
plot(showLevels and activeTradeDir != 0 ? activeStop : na, "Stop", color=color.new(color.red, 0), style=plot.style_linebr)
plot(showLevels and activeTradeDir != 0 ? activeTp1 : na, "TP1", color=color.new(color.orange, 0), style=plot.style_linebr)
plot(showLevels and activeTradeDir != 0 ? activeFinalTarget : na, "Final Target", color=color.new(color.blue, 0), style=plot.style_linebr)

plot(showDebugPlots ? lastSwingHigh : na, "Last Swing High", color=color.new(color.fuchsia, 0), style=plot.style_linebr)
plot(showDebugPlots ? lastSwingLow : na, "Last Swing Low", color=color.new(color.aqua, 0), style=plot.style_linebr)
plot(showDebugPlots ? depthClass : na, "Setup Depth Class", color=color.new(color.yellow, 0), style=plot.style_histogram)
plot(showDebugPlots ? structureBias : na, "Structure Bias", color=color.new(color.silver, 0), style=plot.style_histogram)

var table dash = table.new(position.bottom_right, 2, 10, border_width=1)

if barstate.islast and showDashboard
    table.clear(dash, 0, 0)
    table.cell(dash, 0, 0, "SMC Reversal", text_color=color.white, bgcolor=color.rgb(35, 35, 60))
    table.cell(dash, 1, 0, "Indicator", text_color=color.orange, bgcolor=color.rgb(35, 35, 60))
    table.cell(dash, 0, 1, "Setup")
    table.cell(dash, 1, 1, activeSetupDir == 1 ? "Bull" : activeSetupDir == -1 ? "Bear" : "None", text_color=activeSetupDir == 1 ? color.lime : activeSetupDir == -1 ? color.red : color.silver)
    table.cell(dash, 0, 2, "Trade")
    table.cell(dash, 1, 2, activeTradeDir == 1 ? "Long Active" : activeTradeDir == -1 ? "Short Active" : "No Active Trade", text_color=activeTradeDir == 1 ? color.lime : activeTradeDir == -1 ? color.red : color.silver)
    table.cell(dash, 0, 3, "Reason")
    table.cell(dash, 1, 3, activeTradeDir != 0 ? activeTradeReason : lastSetupReason)
    table.cell(dash, 0, 4, "Depth")
    table.cell(dash, 1, 4, activeTradeDir != 0 ? activeTradeDepthName : depthName)
    table.cell(dash, 0, 5, "Confirm")
    table.cell(dash, 1, 5, confirmName)
    table.cell(dash, 0, 6, "Signal")
    table.cell(dash, 1, 6, signalLong ? "BUY" : signalShort ? "SELL" : "WAIT", text_color=signalLong ? color.lime : signalShort ? color.red : color.silver)
    table.cell(dash, 0, 7, "Entry/SL")
    table.cell(dash, 1, 7, activeTradeDir != 0 ? str.tostring(activeEntry, format.mintick) + " / " + str.tostring(activeStop, format.mintick) : "-")
    table.cell(dash, 0, 8, "TP1/TP2")
    table.cell(dash, 1, 8, activeTradeDir != 0 ? str.tostring(activeTp1, format.mintick) + " / " + str.tostring(activeFinalTarget, format.mintick) : "-")
    table.cell(dash, 0, 9, "Trend")
    table.cell(dash, 1, 9, trendLongOk and trendShortOk ? "Off" : trendLongOk ? "Bull OK" : trendShortOk ? "Bear OK" : "Blocked")
else if barstate.islast
    table.clear(dash, 0, 0)

alertcondition(signalLong, "SMC Reversal Indicator BUY", "Bullish BOS/ChoCh + Fib retest + confirmation")
alertcondition(signalShort, "SMC Reversal Indicator SELL", "Bearish BOS/ChoCh + Fib retest + confirmation")
alertcondition(longStopHit or shortStopHit, "SMC Reversal Stop Hit", "Active trade hit stop loss")
alertcondition(longTargetHit or shortTargetHit, "SMC Reversal Target Hit", "Active trade hit final target")
